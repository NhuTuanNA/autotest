{
  "info": {
    "_postman_id": "d7bcfc13-6a16-4a5e-96e4-autotest-learning",
    "name": "Automation Learning",
    "description": "Collection nhập môn API Testing cho khóa Automation Testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Post 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/1",
          "protocol": "https",
          "host": ["jsonplaceholder", "typicode", "com"],
          "path": ["posts", "1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Post id is 1\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.eql(1);",
              "});",
              "",
              "pm.test(\"Response has title\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('title');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST Post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"bank transfer\",\n  \"body\": \"first API test\",\n  \"userId\": 1\n}"
        },
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts",
          "protocol": "https",
          "host": ["jsonplaceholder", "typicode", "com"],
          "path": ["posts"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Title is correct\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.title).to.eql('bank transfer');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
